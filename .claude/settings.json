{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/stop-services.mjs --quiet || true",
            "timeout": 30,
            "statusMessage": "Stopping local pipeline services"
          }
        ]
      }
    ]
  }
}
